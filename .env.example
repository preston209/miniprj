# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: Required MongoDB Atlas connection string.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/havenstay_pg?retryWrites=true&w=majority"

# SEED_SAMPLE_DATA: Set to "true" ONLY if you want to auto-populate sample HavenStay Koramangala demo data when the database is empty.
SEED_SAMPLE_DATA="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas connection string (required for Mongoose & Atlas Vector Search).
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/havenstay_pg?retryWrites=true&w=majority"
